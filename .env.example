# =============================================================================
# NexusCore ERP • Dockhand Environment Configuration
# =============================================================================

# Server Port Exposure (Default: 5000)
PORT=5000

# PostgreSQL Credentials
DB_NAME=nexus_db
DB_USER=postgres
DB_PASSWORD=change_this_to_a_strong_password_in_production

# JWT Authentication Secret (Generate random 64-character string)
JWT_SECRET=change_this_to_a_long_random_jwt_secret_64_chars_min

# Zero-Trust Credential Vault AES-256 Key (64-character Hex String)
# Example: openssl rand -hex 32
VAULT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Environment Mode
ENVIRONMENT=production

# Storage Directory
STORAGE_PATH=/app/data
